# ── Rutas multimedia ────────────────────────────────────────────────
# La TUI solo permite navegar dentro de estas carpetas.
MEDIA_PATH_MOVIES=/media/Movies
MEDIA_PATH_TV=/media/TV

# ── Binarios del sistema ────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ── Traducción ──────────────────────────────────────────────────────
# Proveedores disponibles:
#   deep-translator → Google Translate gratuito (sin modelo, sin API key)
#   deepseek        → DeepSeek (deepseek-chat / deepseek-reasoner)
#   ollama          → LLM local gratuito y offline (requiere Ollama instalado)
#   openai          → OpenAI u API compatible (GPT, Groq, OpenRouter...)
TRANSLATION_PROVIDER=deep-translator

# Si usa deepseek:
#   DEEPSEEK_API_KEY=sk-...
#   DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#   DEEPSEEK_MODEL=deepseek-chat

# Si usa ollama:
#   OLLAMA_URL=http://localhost:11434
#   OLLAMA_MODEL=qwen2.5:7b          # instalar con: ollama pull qwen2.5:7b

# Si usa openai / API compatible:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini

# ── Escaneo automático ──────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15
