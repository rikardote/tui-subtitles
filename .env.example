# ═══════════════════════════════════════════════════════════════════
#  Subtitle Processor — Configuración (ejemplo)
# ═══════════════════════════════════════════════════════════════════

# ── Rutas multimedia ────────────────────────────────────────────────
MEDIA_PATH_MOVIES=/media/Movies
MEDIA_PATH_TV=/media/TvShows

# ── Binarios ────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ── Traducción ──────────────────────────────────────────────────────
# Proveedores: deep-translator | deepseek | meta-muse | ollama | openai
TRANSLATION_PROVIDER=deepseek

# Meta Muse Spark (Meta Model API) — modelo Contributor: $0.10/$0.20 por M
META_MUSE_API_KEY=
META_MUSE_BASE_URL=https://api.ai.meta.com/v1
META_MUSE_MODEL=muse-spark-1.2

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama (local, gratuito)
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=gemma2:2b

# OpenAI / compatible (OpenRouter, Groq...)
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# deep-translator (Google, gratuito)
#DEEP_TRANSLATOR_BIN=/home/USER/.local/bin/deep-translator

# ── Escaneo ─────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15
TRANSLATION_BATCH_SIZE=15
TRANSLATION_TIMEOUT_SECONDS=300
